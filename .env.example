# GEMINI_API_KEY: Required for Gemini AI API calls (text explainability/translation via gemini-4-hydrogen,
# voice incident transcription via gemini-3.5-transcribe, and multilingual Cloud TTS via gemini-3.8-flash-lite-tts).
# When omitted in local/offline dev, POST /api/worker/:id/speak returns 503 (no_api_key) and the client
# gracefully falls back to browser Web Speech API (SpeechSynthesisUtterance).
# AI Studio / Vercel injects this at runtime from Secrets / Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENWEATHER_API_KEY: Optional OpenWeatherMap API key for Abu Dhabi live station data.
# When omitted, SiteGuard automatically streams live weather via Open-Meteo (24.4539° N, 54.3773° E)
# and falls back seamlessly to Gemma 4 Edge Offline Mode when connectivity drops.
OPENWEATHER_API_KEY=""
